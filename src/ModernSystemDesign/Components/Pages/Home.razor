@page "/"

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

@inject INoteService NoteService

<ul>
    @foreach (var note in notes)
    {
        <li>@note.Title</li>
    }
</ul>

@code {
    private IReadOnlyList<Note> notes = [];

    protected override async Task OnInitializedAsync() => notes = await NoteService.GetAllAsync();
}
